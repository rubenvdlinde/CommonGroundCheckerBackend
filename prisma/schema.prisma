generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RepoAnalysis {
  id        String   @id @default(uuid())
  repoId    String
  repository Repo    @relation(fields: [repoId], references: [id], onDelete: Cascade)
  scoringConfigId String?
  scoringConfig   ScoringConfig? @relation(fields: [scoringConfigId], references: [id], onDelete: SetNull)
  checkedAt DateTime
  version   String?
  scannedRef     String?
  scannedRefKind String?
  scannedCommit  String?
  declaredUsers      String[] @default([])
  declaredUserCount  Int?
  score     Int
  rating    Float?
  categoryRatings Json?
  aspectRatings   Json?
  endorsement     Json?
  checklistVersion String?
  developmentStatus String?
  results   Json
  createdAt DateTime @default(now())
  drops     MaintenanceDrop[] @relation("DropAnalysis")
  resolvedDrops MaintenanceDrop[] @relation("DropResolvedAnalysis")

  @@index([repoId])
  @@index([scoringConfigId])
  @@index([createdAt])
}

model Repo {
  id        String         @id @default(uuid())
  repoUrl   String         @unique
  owner     String
  name      String
  description            String?
  language               String?
  stars                  Int      @default(0)
  forks                  Int      @default(0)
  defaultBranch          String?
  topics                 String[] @default([])
  license                String?
  version                String?
  versionEvidenceSource  String?
  versionEvidenceDetail  String?
  helmChartLocations       String[]
  dockerLocations          String[]
  apiSpecificationLocations String[]
  documentationLocations   String[]
  isRegister               Boolean   @default(false)
  followed                 Boolean   @default(false)
  checkIntervalHours       Int?
  scanRef                  String?
  slaLabels                Json?
  lastCheckedAt            DateTime?
  nextCheckAt              DateTime?
  webhookTokenHash         String?
  retiredAt                DateTime?
  retiredReason            String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  analyses  RepoAnalysis[]
  slas      RepoSla[]
  drops     MaintenanceDrop[]

  @@index([owner])
  @@index([name])
  @@index([nextCheckAt])
}

model RepoSla {
  id         String   @id @default(uuid())
  repoId     String
  repository Repo     @relation(fields: [repoId], references: [id], onDelete: Cascade)
  party      String
  maintainer String
  startsOn   DateTime @db.Date
  until      DateTime @db.Date
  link       String?
  createdAt  DateTime @default(now())

  @@index([repoId])
}

model ScoringConfig {
  id                         String         @id @default(uuid())
  criterionWeights           Json
  categoryWeights            Json           @default("{}")
  criterionRequirementLevels Json           @default("{}")
  complexityThreshold        Int            @default(15)
  complexityMaxCcnThreshold  Int            @default(30)
  spectralRulesetSource      String         @default("https://static.developer.overheid.nl/adr/ruleset.yaml")
  fixTerms                   Json           @default("{}")
  kpiTargets                 Json           @default("{}")
  slaTerms                   Json           @default("{}")
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  analyses                   RepoAnalysis[]
}

/// A criterion, rating or verdict that got worse between two analyses of
/// the same repository and scanned ref kind. Open until a later analysis
/// recovers it.
model MaintenanceDrop {
  id                 String        @id @default(uuid())
  repoId             String
  repository         Repo          @relation(fields: [repoId], references: [id], onDelete: Cascade)
  analysisId         String
  analysis           RepoAnalysis  @relation("DropAnalysis", fields: [analysisId], references: [id], onDelete: Cascade)
  previousAnalysisId String
  scannedRefKind     String?
  checklistVersion   String?
  kind               String
  subject            String
  label              String
  fromValue          String
  toValue            String
  detectedAt         DateTime
  fixTermDays        Int
  fixBy              DateTime
  resolvedAt         DateTime?
  resolvedAnalysisId String?
  resolvedAnalysis   RepoAnalysis? @relation("DropResolvedAnalysis", fields: [resolvedAnalysisId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())

  @@index([repoId, resolvedAt])
  @@index([analysisId])
}
